[user]
	email = anders.bjornstad@axbit.com
	name = Anders Granskogen Bjørnstad
[core]
	editor = emacsclient -t
	autocrlf = 
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	l = "! git lg | head"
	bc = branch --contains
	b = branch -v
	fp = format-patch -k -M -N
	s = status --short
	hot = for-each-ref --format='%(refname:short)' --count 10 --sort='-committerdate' refs/heads\n
	wt-merge = "!f() { branch=$1; [ -n \"$branch\" ] || { echo \"usage: git wt-merge <feature-branch>\" >&2; return 2; }; worktree=$(git worktree list --porcelain | while IFS= read -r line; do case \"$line\" in \"worktree \"*) path=${line#worktree } ;; \"branch refs/heads/$branch\") printf \"%s\\n\" \"$path\"; break ;; esac; done); [ -n \"$worktree\" ] || { echo \"No worktree found checking out branch: $branch\" >&2; return 1; }; git merge --no-ff \"$branch\" && git worktree remove \"$worktree\" && git branch -d \"$branch\"; }; f"

[rebase]
	autosquash = true
[color]
	diff = auto
	status = auto
	interactive = auto
	branch = auto
	ui = true
[log]
	decorate = short
[grep]
	linenumber = true
[sendemail]
	smtpencryption = tls
	smtpserver = smtp.gmail.com
	smtpuser = andersgb@gmail.com
	smtpserverport = 587
[rerere]
	enabled = true
[credential "https://source.developers.google.com"]
	helper = gcloud.sh
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
# [diff "jupyternotebook"]
